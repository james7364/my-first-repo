@page
@model TasksModel
@{
    ViewData["Title"] = "My Todo List";
}

<div class="container mt-4">
    <h2>My Task Manager</h2>

    <!-- Task Creation Form -->
    <div class="card p-3 mb-4 shadow-sm">
        <h4>Add a New Task</h4>
        <form method="post">
            <div class="mb-3">
                <label asp-for="NewTask.Title" class="form-label"></label>
                <input asp-for="NewTask.Title" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="NewTask.Description" class="form-label"></label>
                <textarea asp-for="NewTask.Description" class="form-control"></textarea>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="NewTask.Priority" class="form-label">Priority</label>
                    <select asp-for="NewTask.Priority" class="form-select">
                        <option value="1">Low</option>
                        <option value="2">Medium</option>
                        <option value="3">High</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="NewTask.ColorHex" class="form-label">Card Color</label>
                    <input asp-for="NewTask.ColorHex" type="color" class="form-control form-control-color" value="#ffffff" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="NewTask.DueDate" class="form-label">Due Date</label>
                    <input asp-for="NewTask.DueDate" type="date" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Add Task</button>
        </form>
    </div>

    <!-- Task List Display with Filters -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Your Tasks</h4>
        <div class="btn-group" role="group">
            <a asp-page="./Tasks" asp-route-filter="all" class="btn btn-outline-secondary @(Model.Filter == "all" ? "active" : "")">All</a>
            <a asp-page="./Tasks" asp-route-filter="active" class="btn btn-outline-secondary @(Model.Filter == "active" ? "active" : "")">Active</a>
            <a asp-page="./Tasks" asp-route-filter="completed" class="btn btn-outline-secondary @(Model.Filter == "completed" ? "active" : "")">Completed</a>
        </div>
    </div>

    <div class="row">
        @foreach (var task in Model.TaskList)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100" style="background-color: @task.ColorHex;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                @task.Title
                            </h5>
                            <p class="card-text">@task.Description</p>

                            <div class="mb-2">
                                <span class="badge bg-secondary">Priority: @task.Priority</span>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = !task.IsCompleted && task.DueDate.Value.Date < DateTime.Today;
                                    <span class="badge @(isOverdue ? "bg-danger" : "bg-dark")">
                                        Due: @task.DueDate.Value.ToString("yyyy-MM-dd")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="btn-group">
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@task.Id" class="me-1">
                                    <button type="submit" class="btn btn-sm @(task.IsCompleted ? "btn-outline-secondary" : "btn-success")">
                                        @(task.IsCompleted ? "Undo" : "Done")
                                    </button>
                                </form>

                                <a asp-page="./Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            </div>

                            <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this task?');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>